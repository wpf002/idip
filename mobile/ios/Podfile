# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# BlinkID v7 requires iOS 16.0+.
platform :ios, 16.0
prepare_react_native_project!

# Silence compiler warnings emitted by third-party pod source (React Native,
# Folly, glog, SQLite, VisionCamera, etc.) — these are upstream, not our code.
inhibit_all_warnings!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'IDIP' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'IDIPTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # RN 0.74's hermes/codegen script phases write outside Xcode's script
        # sandbox; disabling it fixes the "rsync … Operation not permitted"
        # hermes-engine build failure.
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        # BlinkID v7 needs iOS 16; keep every pod at or above it.
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end
      # Mark pod run-script phases as always-out-of-date to silence the
      # "will run during every build" notices (they intentionally have no
      # output files).
      target.build_phases.each do |phase|
        if phase.isa == 'PBXShellScriptBuildPhase'
          phase.always_out_of_date = '1'
        end
      end
    end

    # App target tweaks (the user project, not the Pods project):
    #  - suppress the harmless "ignoring duplicate libraries: -lc++" ld notice
    #  - silence the "Bundle React Native…" run-script "every build" notice
    installer.aggregate_targets.each do |agg|
      project = agg.user_project
      project.native_targets.each do |t|
        t.build_configurations.each do |config|
          ldflags = config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
          ldflags = [ldflags] if ldflags.is_a?(String)
          ldflags << '-Wl,-no_warn_duplicate_libraries' unless ldflags.include?('-Wl,-no_warn_duplicate_libraries')
          config.build_settings['OTHER_LDFLAGS'] = ldflags
        end
        t.build_phases.each do |phase|
          if phase.isa == 'PBXShellScriptBuildPhase'
            phase.always_out_of_date = '1'
          end
        end
      end
      project.save
    end
  end
end
